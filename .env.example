# ============================================================
# SATQUERY AI
# Environment Configuration
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=SatQuery AI
APP_ENV=development
DEBUG=false

HOST=0.0.0.0
PORT=8000

# Frontend URL(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------------------------
# SUPABASE
# Supabase is the ONLY database/storage backend.
# ------------------------------------------------------------

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# If your backend uses SQLAlchemy/asyncpg directly with
# Supabase PostgreSQL, put the Supabase PostgreSQL connection
# string here.
#
# If your code DOES NOT use DATABASE_URL, remove this variable.
#
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres


# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0

CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------

STORAGE_DIR=./storage

MODEL_DIR=./models

UPLOAD_DIR=./storage/uploads

RESULT_DIR=./storage/results

REPORT_DIR=./storage/reports

MAX_UPLOAD_SIZE_MB=100


# ------------------------------------------------------------
# GPU
# ------------------------------------------------------------

DEVICE=cuda

GPU_ID=0

MAX_CONCURRENT_INFERENCE=1


# ------------------------------------------------------------
# MODELS
# ------------------------------------------------------------

ENABLE_GROUNDING_DINO=true

ENABLE_SAM2=true

ENABLE_CHANGEFORMER=true

ENABLE_ANYSAT=true

# GeoChat is currently disabled because of its compatibility issues.
ENABLE_GEOCHAT=false

# Enable only when a real external VLM API key is configured.
ENABLE_EXTERNAL_VLM=false


# ------------------------------------------------------------
# MODEL DIRECTORIES
# ------------------------------------------------------------

GROUNDING_DINO_MODEL_DIR=./models/grounding_dino

SAM2_MODEL_DIR=./models/sam2

CHANGEFORMER_MODEL_DIR=./models/changeformer

ANYSAT_MODEL_DIR=./models/anysat

GEOCHAT_MODEL_DIR=./models/geochat


# ------------------------------------------------------------
# MODEL IDENTIFIERS
# ------------------------------------------------------------

GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-base

SAM2_MODEL_ID=facebook/sam2-hiera-tiny

ANYSAT_MODEL_ID=g-astruc/AnySat

# Replace this with the EXACT ChangeFormer checkpoint
# your implementation actually uses.
CHANGEFORMER_MODEL_ID=YOUR_CHANGEFORMER_MODEL_ID

GEOCHAT_MODEL_ID=MBZUAI/GeoChat-7B


# ------------------------------------------------------------
# GROQ
# Used by the agent supervisor / synthesizer / external VLM
# only if your implementation actually uses it.
# ------------------------------------------------------------

GROQ_API_KEY=YOUR_REAL_GROQ_API_KEY

GROQ_MODEL=YOUR_SUPPORTED_GROQ_MODEL


# ------------------------------------------------------------
# GEMINI
# Only required if the application actually uses Gemini.
# ------------------------------------------------------------

GEMINI_API_KEY=YOUR_REAL_GEMINI_API_KEY


# ------------------------------------------------------------
# ANALYSIS
# ------------------------------------------------------------

DEFAULT_ANALYSIS_TIMEOUT=300

MAX_ANALYSIS_RETRIES=2

CELERY_WORKERS=1


# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=INFO

LOG_FORMAT=json


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET

API_KEY=GENERATE_A_LONG_RANDOM_API_KEY


# ------------------------------------------------------------
# REPORTS
# ------------------------------------------------------------

REPORTS_DIR=./storage/reports

REPORT_RETENTION_DAYS=30


# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------

ENABLE_METRICS=true

ENABLE_REQUEST_LOGGING=true


# ------------------------------------------------------------
# API DOCUMENTATION
# ------------------------------------------------------------

ENABLE_SWAGGER=true

ENABLE_REDOC=true